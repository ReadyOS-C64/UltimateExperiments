REM BACKUP SOURCE DEST PREVIEW OR APPLYONERROR STOPSET "SRC=%1"SET "DST=%2"IF "%SRC%"=="" GOTO USAGEIF "%DST%"=="" GOTO USAGEIF NOT EXIST "%SRC%" GOTO MISSINGIF "%3"=="PREVIEW" GOTO PREVIEWIF NOT "%3"=="APPLY" GOTO USAGEIF EXIST "%DST%" GOTO EXISTSCALL :COPYONEIF NOT DEFINED BACKUPS SET BACKUPS=0SET /A BACKUPS=BACKUPS+1ECHO BACKUPS THIS SESSION: %BACKUPS%EXIT /B 0:COPYONECOPY "%SRC%" "%DST%"COMPARE "%SRC%" "%DST%"ECHO BACKUP VERIFIEDEXIT /B 0:PREVIEWCOPY "%SRC%" "%DST%" --WHATIFEXIT /B:EXISTSECHO DEST EXISTS - CHOOSE NEW NAMEEXIT /B 6:MISSINGECHO SOURCE NOT FOUND: "%SRC%"EXIT /B 5:USAGEECHO RUN BACKUP SOURCE DEST PREVIEWECHO RUN BACKUP SOURCE DEST APPLYEXIT /B 4