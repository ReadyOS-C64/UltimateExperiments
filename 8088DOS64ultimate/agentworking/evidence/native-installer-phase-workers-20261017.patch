+ case PB_A_BYTES:pair=RC_A_PAIR;break;
+ case PB_A_CRC:pair=RC_A_PAIR+1u;break;
+ case PB_B_BYTES:pair=RC_B_PAIR;break;
+ case PB_B_CRC:pair=RC_B_PAIR+1u;break;
+ case PB_C_BYTES:pair=RC_C_PAIR;break;
