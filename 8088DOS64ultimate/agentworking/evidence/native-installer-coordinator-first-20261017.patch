+br_u8 rc_capture(void){br_u8 k;
+ if(retained.started||su_state()!=SU_DONE||!rc_expected_ticket||so_ui_ticket()!=rc_expected_ticket||!bc_files_closed())return 0;
+ retained.started=1;sq_page=0;if(sq_read()!=512u)return 0;
+ retained.generation=word(sq_bytes+8);memcpy(retained.home,sq_bytes+SQ_HOME,128);
+ sq_page=1;if(sq_read()!=192u)return 0;
+ retained.identity=dword(sq_bytes+188);retained.flags=sq_bytes[160]|(sq_bytes[161]<<1);
+ for(k=0;k<5u;++k){
+  sl_kind=k;sl_generation=retained.generation;sl_identity=retained.identity;
+  if(!sl_fact()||sl_receipt.generation!=retained.generation||sl_receipt.identity!=retained.identity||sl_receipt.bytes!=(k<3u?368640UL:k==3u?18432UL:64UL))return 0;
+  retained.source_crc[k]=sl_receipt.crc;retained.source_mask|=1u<<k;
+ }
+ if(so_ui_ticket()!=rc_expected_ticket||sq_state()!=SQ_READY||!bc_files_closed())return 0;
+ retained.valid=1;rc_generation=retained.generation;rc_identity=retained.identity;
+ rc_flags=retained.flags;rc_source_mask=retained.source_mask;return 1;
