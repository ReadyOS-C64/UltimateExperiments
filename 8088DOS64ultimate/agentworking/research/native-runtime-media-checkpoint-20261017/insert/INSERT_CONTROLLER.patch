+ pha
+ lda #1
+ sta fatal
+ lda #$e1
+ sta dos64_native_diag
+ pla
+ jmp latch
+quiet:
+ lda dos64_uci_recovery_failed
+ bne @bad
+ lda dos64_uci_state
+ beq @ok
+ cmp #9
+ beq @ok
+ cmp #10
+ bne @bad
+@ok: clc
+ rts
+@bad: sec
+ rts
+clock:
+ lda #0
+ sta sample_count
+@sample:
+ jsr dos64_elapsed_poll
+ bcc @fresh
+ lda dos64_host_clock_status
