+ sec
+ lda dos64_host_clock_ticks
+ sbc raw_last
+ lda dos64_host_clock_ticks+1
+ sbc raw_last+1
+ lda dos64_host_clock_ticks+2
+ sbc raw_last+2
+ lda dos64_host_clock_ticks+3
+ sbc raw_last+3
+ cmp #8
