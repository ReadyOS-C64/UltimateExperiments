10 REM C64 ULTIMATE - ASCII HANGMAN
20 REM AUTOPLAY: THREE MISSES THEN A WIN
30 SCREEN 0:WIDTH 40:KEY OFF:CLS
40 W$="ULTIMATE":G$="ZXQULTIMAE"
50 D$=STRING$(LEN(W$),"-"):M%=0
60 FOR N%=1 TO LEN(G$)
70 C$=MID$(G$,N%,1):H%=0
80 FOR J%=1 TO LEN(W$)
90 IF MID$(W$,J%,1)=C$ THEN MID$(D$,J%,1)=C$:H%=1
100 NEXT J%
110 IF H%=0 THEN M%=M%+1
120 GOSUB 300
130 IF D$=W$ THEN 200
140 REM TIMER PACES THE SELF-PLAY DEMO
150 T!=TIMER:FOR P%=1 TO 200
160 IF TIMER-T!>=1 OR TIMER<T! THEN 180
170 NEXT P%
180 NEXT N%
190 LOCATE 18,3:PRINT "THE WORD WAS ";W$:GOTO 220
200 LOCATE 18,3:PRINT "YOU WIN!  C64 ULTIMATE!"
210 LOCATE 19,3:PRINT "WORD: ";W$
220 LOCATE 21,3:PRINT "GAME COMPLETE - AUTOPLAY"
230 LOCATE 22,3:PRINT "Use LIST to read the BASIC code."
240 END
300 CLS:LOCATE 1,5:PRINT "GW-BASIC ASCII HANGMAN"
310 LOCATE 3,3:PRINT "AUTOPLAY GUESS ";N%;": ";C$
320 LOCATE 5,7:PRINT "+-------+"
330 LOCATE 6,7:PRINT "|       |"
340 LOCATE 7,7:PRINT "|":IF M%>0 THEN LOCATE 7,15:PRINT "O"
350 LOCATE 8,7:PRINT "|":IF M%>1 THEN LOCATE 8,15:PRINT "|"
360 LOCATE 9,7:PRINT "|":IF M%>2 THEN LOCATE 9,14:PRINT "/"
370 LOCATE 10,7:PRINT "|"
380 LOCATE 11,5:PRINT "__|__________"
390 LOCATE 13,3:PRINT "WORD: ";D$
400 LOCATE 15,3:PRINT "MISSES: ";M%;" / 6"
410 LOCATE 16,3:PRINT "GUESSED: ";LEFT$(G$,N%)
420 RETURN
