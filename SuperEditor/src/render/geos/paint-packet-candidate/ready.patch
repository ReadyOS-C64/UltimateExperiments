--- a/src/render/geos/page-paint.s
+++ b/src/render/geos/page-paint.s
@@ -383,6 +383,22 @@
     ldy #>CHARS
     jsr array_request
     jcs fail
+    lda GPP_KIND
+    bne @single_field
+    ; CHARS are already in place. The gathered style/role slices begin162
+    ; and324 bytes later. Ascending order is required: role destinations may
+    ; overlap only style source bytes that were copied earlier in this loop.
+    ldx #0
+@gather:
+    lda CHARS+(GPR_STYLES-GPR_CHARS),x
+    sta STYLES,x
+    lda CHARS+(GPR_ROLES-GPR_CHARS),x
+    sta ROLES,x
+    inx
+    cpx GPP_COUNT
+    bcc @gather
+    jmp flags_ready
+@single_field:
     lda #P_STYLES
     sta GPP_PHASE
     jmp pending
@@ -401,6 +417,7 @@
     ldy #>ROLES
     jsr array_request
     jcs fail
+flags_ready:
     lda want_selection
     bne @maps
     jsr caret_line
@@ -910,9 +927,27 @@
     lda destination_lo-P_CHARS,y
     sta host
     lda GPP_COUNT
+    jeq argument
+    cmp #65
+    jcs argument
     sta amount
     lda #0
     sta amount+1
+    lda GPP_PHASE
+    cmp #P_CHARS
+    bne @fetch
+    lda GPP_KIND
+    bne @fetch
+    ; One checked contiguous transfer covers the same three field slices.
+    ; Existing public chunks are1..64; no source or worker loop is enlarged.
+    clc
+    lda amount
+    adc #<(GPR_ROLES-GPR_CHARS)
+    sta amount
+    lda #>(GPR_ROLES-GPR_CHARS)
+    adc #0
+    sta amount+1
+@fetch:
     jmp fetch
 row_setup:
     lda GPP_ROW
