.ifndef SE_GEOS_PREVIEW_CACHE
SE_GEOS_PREVIEW_CACHE=1
; Preview body image; no resident BSS/ZP. All extents inside existing FEbank.
PPC_META=$8900
PPC_CHUNK=$8A00
PPC_META_REU=$EA88
PPC_DATA_REU=$B200
PPC_BITMAP_LEN=7040
PPC_ATTR_LEN=880
PPC_DATA_LEN=PPC_BITMAP_LEN+PPC_ATTR_LEN
PPC_SIZE=225
PPC_CAPS=3 ;previously reserved; included in metadata CRC
PPC_SOURCE=8
PPC_SETTINGS=67
PPC_TOP=131
PPC_FOLD_VALID=134
PPC_FOLD_TOKEN=135
PPC_FOLD_COUNT=140
PPC_FOLD_GENERATION=142
PPC_BOTTOM=144
PPC_ROWS=147
PPC_ANCHORS=148
PPC_CRC=214
PPC_FONT_READY=216
PPC_FONT_HANDLES=217
PPC_FONT_MAP=219
PPC_FONT_EPOCH=221
PPC_META_CRC=223
PPC_STATE=PP_STATE+67
PPC_ARMED=PPC_STATE
PPC_CAPTURE=PPC_STATE+1
PPC_CURSOR=PPC_STATE+2
PPC_VALUE=PPC_STATE+4
PPC_COUNT=PPC_STATE+6
PPC_ZERO=PPC_STATE+7
PPC_SAVED=PPC_STATE+8 ;two-byte private scratch
PPC_META_FIRST=8
PPC_META_LAST=9
PPC_CRC_PHASE=10
PPC_BODY_MEMO=PP_STATE+77 ;sticky0onEVERYcheckedREUwrite/provider/resume
.assert PPC_META+PPC_SIZE<=PPC_CHUNK,error,"preview metadata overlaps CRC chunk"
.assert PPC_CHUNK+128<=$8B40,error,"preview chunk overlaps semantic checkpoint"
.assert PPC_META_REU+PPC_SIZE<=$10000,error,"preview metadata outside FE"
.assert PPC_DATA_REU+PPC_DATA_LEN<=$D528,error,"preview body exceeds reserved snapshot"

.endif
