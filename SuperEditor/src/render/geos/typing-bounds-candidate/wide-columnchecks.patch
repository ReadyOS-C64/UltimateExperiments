     bne @no_prefix
     lda (gt_base),y
     and prefix
     bcs @prefix_ready ;carry from CPY equality is stillset
-@original:
-    lda (gt_base),y
-    jmp @prefix_ready
 @no_prefix:
     lda #0
 @prefix_ready:
@@ -141,11 +150,7 @@
     lda work
     cpy nb
     bcc @store
-    bne @empty
     and endmask
-    jmp @store
-@empty:
-    lda #0
 @store:
     sta GT_TEMP,y
