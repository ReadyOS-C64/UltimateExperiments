+ ldy #62
+ lda se_crc_value
+ sta (text_ptr),y
+ iny
+ lda se_crc_value+1
+ sta (text_ptr),y
+ ldy #3
+ lda #0
+ sta (text_ptr),y
+ lda SLOT
+ sta se_reu_offset
+ lda text_ptr
+ sta se_reu_c64
+ lda #64
+ sta se_reu_length
+ lda #0
+ jsr se_reu_copy
+ jcs cleanup
