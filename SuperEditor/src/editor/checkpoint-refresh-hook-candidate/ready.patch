+ jne cleanup
+ cmp se_gc_epoch,x
+ jne cleanup
+ cmp GCC_EPOCH,x
+ jne cleanup
+ lda se_doc_epoch,x
+ cmp GEC_DOC_EPOCH,x
+ jne cleanup
