+record:
+ ldy #0
+@header:
+ lda (text_ptr),y
+ cmp header,y
+ jne bad
+ iny
+ cpy #4
+ bcc @header
+ jsr checksum
+ ldy #62
+ lda (text_ptr),y
+ cmp se_crc_value
+ jne bad
+ iny
+ lda (text_ptr),y
+ cmp se_crc_value+1
+ jne bad
+ ; Each fullkey must be exactly OLD or NEW, never an unproved revision gap.
+ ldy #7
+ ldx #0
+@old:
+ lda (text_ptr),y
+ cmp OLD,x
+ bne @newstart
+ iny
+ inx
+ cpx #28
+ bcc @old
+ beq @TOP
+@newstart:
+ ldy #7
+ ldx #0
+@new:
+ lda (text_ptr),y
+ cmp GCC_KEY,x
+ jne bad
+ iny
+ inx
+ cpx #28
+ bcc @new
+@TOP:
+ ldy #41
+ ldx #0
+@bound:
+ lda (text_ptr),y
+ cmp se_v_top,x
+ jne bad
+ iny
+ inx
+ cpx #3
+ bcc @bound
+ ldy #4
+ ldx #0
+@anchor:
+ lda (text_ptr),y
+ sta T,x
+ iny
+ inx
+ cpx #3
+ bcc @anchor
+ CMP24 T,se_v_top
+ lda SLOT ;LDA preserves carry from24bit comparison
+ beq @current
+ jcs bad
+ clc
+ rts
+@current:
+ ; Carry set plus zero means currentSTART exactlyTOP.
+ jcc bad
+ lda T
+ cmp se_v_top
+ jne bad
+ lda T+1
+ cmp se_v_top+1
+ jne bad
+ lda T+2
+ cmp se_v_top+2
+ jne bad
+ clc
+ rts
+bad:
+ sec
+ rts
