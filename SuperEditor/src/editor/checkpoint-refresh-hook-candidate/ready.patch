+ lda #1
+ sta (text_ptr),y
+ lda SLOT
+ clc
+ adc #3
+ sta se_reu_offset
+ lda text_ptr
+ clc
+ adc #3
+ sta se_reu_c64
+ lda #1
+ sta se_reu_length
+ lda #0
+ jsr se_reu_copy
+ jcs cleanup
+ lda SLOT
+ bne success
+ lda COUNT
+ cmp #2
+ bne success
+ lda #64
+ sta SLOT
