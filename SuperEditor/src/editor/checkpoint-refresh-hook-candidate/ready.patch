+success:
+ jsr se_fs_end
+ lda #0
+ sta se_f_owner
+ lda #1
+ clc
+ rts
+cleanup:
+ jsr se_fs_end
+ lda #0
+ sta se_f_owner
+miss:
+ lda #0
+ clc
+ rts
+pointer:
+ lda SLOT
+ clc
+ adc #<R
+ sta text_ptr
+ lda #>R
+ sta text_ptr+1
+ rts
+checksum:
+ jsr se_crc_init
+ ldy #0
+@byte:
+ lda (text_ptr),y
+ jsr se_crc_byte
+ iny
+ cpy #62
+ bcc @byte
