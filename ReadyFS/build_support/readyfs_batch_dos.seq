REM DOS STYLE FLOW FIXTURE
SET NAME=%1
SET /A N=0
:LOOP
SET /A N=N+1
IF %N% LSS 3 GOTO LOOP
IF NOT "%NAME%"=="WORLD" GOTO BAD
IF NOT DEFINED NAME GOTO BAD
CALL :SUB
IF NOT "%SUB%"=="CALLED" GOTO BAD
IF EXIST 8:/RFBOK GOTO PRESENT
GOTO BAD
:PRESENT
IF NOT EXIST 8:/RFABSENT ECHO EXISTS PASS
ONERROR CONTINUE
NOTACOMMAND
IF NOT ERRORLEVEL 1 GOTO BAD
ECHO ERRORLEVEL PASS %ERRORLEVEL%
IF 3 GEQ 3 ECHO DOS FLOW PASS %NAME% %N%
EXIT /B 0
:SUB
SET SUB=CALLED
EXIT /B 0
:BAD
EXIT /B 9
